# Copy to .env and fill in. Never commit .env.

# PrimeVue 5 / PrimeUI license key. The @primevue/nuxt-module reads this env var
# directly, so nuxt.config needs no change.
NUXT_PUBLIC_PRIMEUI_LICENSE=""

NUXT_PUBLIC_API_BASE="http://localhost:3001"
NUXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Publishable key only. The Stripe SECRET key never appears in this workspace.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
