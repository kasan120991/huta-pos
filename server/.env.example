# Copy to .env and fill in. Never commit .env.

# Local dev via docker-compose (host port 55432 avoids colliding with a native install).
DATABASE_URL="postgresql://huta:huta@localhost:55432/huta_pos?schema=public"

# --- Auth ------------------------------------------------------------------------------
# Generate each with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# Signs short-lived access tokens. Rotating it logs everyone out — survivable.
JWT_SECRET=""

# Peppers the deterministic PIN lookup: pinLookup = HMAC-SHA256(pin, PIN_PEPPER).
#
# NOT survivable to rotate. Changing this invalidates EVERY staff and admin PIN at once,
# because the stored lookup values were derived with the old pepper and cannot be
# recomputed from the argon2 hashes. Treat it as permanent. If it ever must change, every
# PIN has to be reset by hand.
PIN_PEPPER=""

# Origin(s) allowed to send credentialed requests. Comma-separated.
# Must be an exact match — `credentials: true` makes a wildcard illegal.
#
# In DEVELOPMENT ONLY, src/config/origins.ts also admits http+https on :3000 for localhost,
# 127.0.0.1 and this machine's RFC-1918 addresses, so `DEV_TLS=1` and the iPad-over-LAN setup
# work without editing this. In production the list below is the whole allowlist, exactly.
CORS_ORIGIN="http://localhost:3000"

# Set DEV_TLS=1 in the SHELL (not here) to serve both the app and this API over TLS in dev,
# using app/.certs — needed for the iPad camera scanner, and it keeps realtime working:
#   DEV_TLS=1 pnpm dev

# --- Stripe ----------------------------------------------------------------------------
# All optional — a keyless environment boots and disables card payments. Test-mode keys
# (sk_test_/pk_test_) are fine in development; no real charges happen.
# Secret key is server-side ONLY and never reaches the browser.
STRIPE_SECRET_KEY=""
# The one Stripe value the client ever sees (via GET /api/payments/config).
STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen --forward-to localhost:3001/api/stripe/webhook` in dev.
STRIPE_WEBHOOK_SECRET=""

PORT="3001"
NODE_ENV="development"
